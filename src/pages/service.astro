---
import Layout from '../layouts/Layout.astro'
import SectionHeading from '../components/SectionHeading.astro'

// 刺繍とプリントは対立するものではなく、1着の中で組み合わせることもあるため、
// 優劣の比較ではなく「それぞれの魅力」として紹介する（内容はサイト内の既存の記載から）
const features = [
  {
    en: 'Embroidery',
    title: '刺繍の魅力',
    lead: '糸で布地に縫い込む刺繍は、ユニフォーム・作業着・キャップへのロゴやお名前入れを得意としています。',
    points: ['立体感と高級感のある仕上がり', '糸そのものが素材に定着し、洗濯を繰り返しても色落ちしにくい', '多色対応（最大15色）', '小ロット1枚〜大量生産まで'],
  },
  {
    en: 'Print',
    title: 'プリントの魅力',
    lead: 'DTF・シルクスクリーン・UVプリンターを保有。用途・数量・素材に応じて最適なプリント方法をご提案します。',
    points: ['DTFプリント：版が不要で、1枚からフルカラーに対応', 'シルクスクリーン：量産・高耐久', 'UVプリント：立体物・グッズにも直接プリント', '転写プリントにも対応'],
  },
]

const useCases = [
  { title: 'ユニフォーム・作業着', description: '会社名・ロゴの刺繍入れ。チームの一体感と信頼感を高めます。' },
  { title: 'スポーツチーム', description: 'チーム名・背番号・ワッペンなど。各種スポーツユニフォームに対応。' },
  { title: '記念品・ノベルティ', description: '卒業記念、イベント記念品など。名前入れで特別な一品に。' },
  { title: 'アパレルブランド', description: 'ブランドネーム・タグ・ワッペンの製作。小ロットから対応可能。' },
  { title: '学校・幼稚園', description: '体操着・スモック・帽子へのお名前刺繍。個人のお客様も歓迎。' },
  { title: '飲食店・サービス業', description: 'エプロン・コックコート・キャップへの店名・ロゴ入れ。' },
]

const services = [
  {
    id: 'embroidery',
    title: '刺繍加工',
    en: 'Embroidery',
    image: '/images/facility/embroidery-line.jpg',
    alt: 'バルダン多頭式刺繍機が並ぶ刺繍加工ライン',
    width: 1109,
    height: 1477,
    description: '多頭式・単頭式の刺繍機を合計14台保有。ユニフォーム、作業着、キャップなどへのロゴ・ネーム刺繍を得意としています。',
    features: ['立体感と高級感のある仕上がり', '多色対応（最大15色）', '小ロット1枚〜大量生産まで', 'オリジナルデザインのデータ作成可'],
  },
  {
    id: 'print',
    title: 'プリント加工',
    en: 'Print',
    image: '/images/facility/dryer.jpg',
    alt: 'プリント加工で使うコンベア式乾燥機',
    width: 1109,
    height: 1477,
    description: 'DTF・シルクスクリーン・UVプリンターを保有。用途・数量・素材に応じて最適なプリント方法をご提案します。',
    features: ['DTFプリント：小ロット・フルカラー対応', 'シルクスクリーン：量産・高耐久', 'UVプリント：立体物・グッズ製作', '転写プリントにも対応'],
  },
  {
    id: 'wappen',
    title: 'ワッペン製作',
    en: 'Patch',
    image: '/images/facility/wappen-sample.jpg',
    alt: 'プリントワッペンのサンプル見本',
    width: 900,
    height: 1600,
    // 縦長写真のため、16:9 ではなく縦長の枠で見本台紙が収まるように表示する
    imageClass: 'aspect-[4/5] object-[center_65%] max-w-md mx-auto',
    description: 'レーザーカッターによるヒートカットワッペン、ロック仕上げワッペンなど、多様な仕様に対応します。',
    features: ['ヒートカット（レーザー加工）', 'ロック仕上げ', 'アイロン接着加工', 'オリジナルデザイン対応'],
  },
  {
    id: 'name',
    title: 'ネーム加工',
    en: 'Name Label',
    image: '/images/facility/happy-japan.jpg',
    alt: 'ネーム刺繍に使う単頭式刺繍機（Happy Japan）',
    width: 1109,
    height: 1477,
    description: 'ユニフォームや作業着への個人名などのネーム刺繍を、単頭式刺繍機で1枚ずつ丁寧に仕上げます。織りネーム・プリントネーム・下げ札など、ブランドの顔となるネームタグの製作も承ります。',
    features: ['個人名・役職名のネーム刺繍', '織りネーム・プリントネーム', '下げ札・タグ', 'サイズ表示・品質表示'],
  },
]

import { url } from '../utils/paths'
---

<Layout
  title="加工サービス一覧｜タグチ刺繍ネーム｜茨城県筑西市の刺繍・プリント加工"
  description="刺繍加工・プリント加工（DTF・シルクスクリーン・UV）・ワッペン製作・ネーム加工のご案内。茨城県筑西市の自社工場で、ユニフォームや作業着、ポロシャツ、キャップへの名入れを1枚から小ロットで承ります。"
>

  <section class="relative h-48 md:h-64 flex items-center">
    <div class="absolute inset-0">
      <picture>
        <source type="image/webp" srcset={url("/images/facility/factory-work-02.webp")} />
        <img src={url("/images/facility/factory-work-02.jpg")} alt="" width="1920" height="1080" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="absolute inset-0 bg-navy-800/70"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 md:px-8 w-full">
      <p class="text-sm text-gold-300 tracking-[0.2em] uppercase mb-2">Service</p>
      <h1 class="heading-accent text-2xl md:text-4xl text-white">刺繍・プリント・ワッペン<br class="sm:hidden" />加工サービス</h1>
      <p class="text-navy-200 text-sm mt-2">茨城県筑西市の自社工場で行う加工方法・対応範囲をご案内します</p>
    </div>
  </section>

  <!-- Page anchor nav -->
  <nav class="bg-warm-50 border-b border-warm-200 sticky top-16 md:top-20 z-40">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8 flex gap-1 overflow-x-auto py-3">
      {services.map((svc) => (
        <a href={`#${svc.id}`} class="shrink-0 px-4 py-2 text-sm text-warm-700 hover:text-navy-800 hover:bg-white rounded transition-colors">
          {svc.title}
        </a>
      ))}
    </div>
  </nav>

  <!-- Service sections -->
  {services.map((svc, i) => (
    <section id={svc.id} class={`py-section-sm md:py-section ${i % 2 === 0 ? '' : 'bg-warm-50'}`}>
      <div class="mx-auto max-w-[1200px] px-4 md:px-8">
        <div class="js-fade-in grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            <picture>
              <source type="image/webp" srcset={url(svc.image.replace(/\.jpg$/, '.webp'))} />
              <img src={url(svc.image)} alt={svc.alt} width={svc.width} height={svc.height} class={`w-full object-cover rounded-lg ${svc.imageClass ?? 'aspect-video'}`} loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
            <span class="text-sm text-warm-500 font-light tracking-[0.2em] uppercase">{svc.en}</span>
            <h2 class="heading-accent text-xl md:text-2xl text-navy-800 mt-1 mb-4">
              <span class="gold-underline">{svc.title}</span>
            </h2>
            <p class="text-warm-700 leading-relaxed mb-6">{svc.description}</p>
            <ul class="space-y-2">
              {svc.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-warm-700">
                  <svg class="w-5 h-5 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            {i === 0 && (
              <a href={url("/facility")} class="mt-6 inline-flex items-center text-sm font-medium text-navy-800 underline underline-offset-4 decoration-gold-400 hover:text-gold-700 transition-colors">
                設備の詳細を見る<svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Features: 刺繍とプリント、それぞれの魅力 -->
  <section id="features" class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1000px] px-4 md:px-8">
      <SectionHeading en="Features" ja="刺繍とプリント、それぞれの魅力" />
      <p class="text-center text-warm-600 text-sm -mt-8 mb-10 leading-relaxed">
        刺繍とプリントは、どちらか一方を選ぶものではありません。<br class="hidden md:block" />1着の中で組み合わせて使うこともできます。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        {features.map((item, i) => (
          <div class="js-fade-in flex flex-col bg-white rounded-lg border border-warm-200 p-6 md:p-8" style={`transition-delay: ${i * 100}ms`}>
            <span class="text-xs text-warm-500 font-light tracking-[0.2em] uppercase">{item.en}</span>
            <h3 class="heading-accent text-lg md:text-xl text-navy-800 mt-1 mb-3">
              <span class="gold-underline">{item.title}</span>
            </h3>
            <p class="text-sm text-warm-700 leading-relaxed mb-5">{item.lead}</p>
            <ul class="space-y-2 pt-4 border-t border-warm-200">
              {item.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-warm-700">
                  <svg class="w-5 h-5 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-warm-600 mt-6">
        どの加工が合うかわからない場合も、お気軽にご相談ください。用途に合わせて最適な加工方法をご提案します。
      </p>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-section-sm md:py-section bg-warm-50">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Use Cases" ja="こんな用途に使えます" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {useCases.map((item, i) => (
          <div class="js-fade-in bg-white rounded-lg border border-warm-200 p-6 hover:shadow-md hover:border-gold-300 transition-all duration-200" style={`transition-delay: ${i * 60}ms`}>
            <h3 class="text-base font-bold text-navy-800 mb-2">{item.title}</h3>
            <p class="text-sm text-warm-600 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="py-section-sm md:py-section bg-navy-50">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">
      <SectionHeading en="Tips" ja="ご注文前に知っておきたいこと" />
      <div class="js-fade-in space-y-6">
        <div class="bg-white rounded-lg border border-warm-200 p-6">
          <h3 class="font-bold text-navy-800 mb-2">素材による仕上がりの違い</h3>
          <p class="text-sm text-warm-700 leading-relaxed">
            薄手の生地（Tシャツ素材など）に大きな刺繍を入れると、生地が引っ張られることがあります。厚手の生地（ポロシャツ・作業着・キャップなど）は刺繍に最適です。素材に不安がある場合はお気軽にご相談ください。
          </p>
        </div>
        <div class="bg-white rounded-lg border border-warm-200 p-6">
          <h3 class="font-bold text-navy-800 mb-2">データの準備について</h3>
          <p class="text-sm text-warm-700 leading-relaxed">
            入れたいロゴや文字がわかる画像・データがあれば、そのままお送りください。加工に適した形式かどうかは当社で確認します。「こんなことをしたい」という段階からでもご相談いただけます。
          </p>
        </div>
        <div class="bg-white rounded-lg border border-warm-200 p-6">
          <h3 class="font-bold text-navy-800 mb-2">1枚からでもOKです</h3>
          <p class="text-sm text-warm-700 leading-relaxed">
            「1枚だけでも注文できますか？」──はい、もちろん承ります。お子様のお名前入れ、チームのユニフォーム、記念品など、1枚から大歓迎です。
          </p>
        </div>
        <a href={url("/guide")} class="group block bg-navy-800 rounded-lg p-6 hover:bg-navy-700 transition-colors">
          <p class="text-xs text-gold-300 tracking-[0.2em] uppercase mb-1">Guide</p>
          <p class="font-bold text-white mb-1 flex items-center">初めての方へ：刺繍ガイド<svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></p>
          <p class="text-sm text-navy-200 leading-relaxed">刺繍加工の基本や、データ入稿（形式・解像度・色指定など）のポイントをまとめています。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-section-sm md:py-section bg-navy-800">
    <div class="mx-auto max-w-[800px] px-4 md:px-8 text-center">
      <div class="js-fade-in">
        <h2 class="heading-accent text-xl md:text-2xl text-white mb-3">加工のご相談・お見積り</h2>
        <p class="text-navy-200 text-sm mb-6">最適な加工方法をご提案いたします。お気軽にお問い合わせください。</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={url("/contact")} class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md">
            お問い合わせ
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href={url("/flow")} class="inline-flex items-center px-8 py-3.5 border border-navy-400 text-white rounded tracking-wider hover:bg-navy-700 transition-all duration-200">
            ご注文の流れ
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
