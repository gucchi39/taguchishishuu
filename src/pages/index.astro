---
import Layout from '../layouts/Layout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Philosophy from '../components/Philosophy.astro'

const pillar = {
  title: '刺繍もプリントも、まとめてお任せください',
  description: '刺繍とプリントの両方を自社工場で行っています。1着に刺繍とプリントを組み合わせるご注文も、まとめて承ります。',
}

const supports = [
  {
    label: '設備',
    description: '刺繍機（多頭機3台・単頭機8台）、プリント機（DTF・シルクスクリーン・UV）、熱プレス機、レーザー加工機をそろえています。',
  },
  {
    label: '人と技術',
    description: '刺繍もプリントも、自社のスタッフが加工しています。',
  },
  {
    label: '信頼',
    description: '1960年の創業から65年、筑西市で加工を続けてきました。',
  },
]

// 加工サービスは「刺繍」と「プリント」の2本柱。
// ネーム（名前入れ）・帽子への刺繍・ワッペン製作などは刺繍加工の中の種類として tags に並べる。
const services = [
  {
    title: '刺繍加工',
    href: '/service#embroidery',
    description: 'ユニフォーム・作業着へのロゴ刺繍から、お名前のネーム入れ、帽子への刺繍、ワッペン製作まで。',
    tags: ['ロゴ刺繍', 'ネーム（名前入れ）', '帽子への刺繍', 'ワッペン製作', '織りネーム・タグ'],
    image: '/images/facility/embroidery-line.jpg',
    alt: 'バルダン多頭式刺繍機が並ぶ刺繍加工ライン',
    width: 1109,
    height: 1477,
  },
  {
    title: 'プリント加工',
    href: '/service#print',
    description: 'DTF・シルクスクリーン・UVプリンターを保有。用途・数量・素材に応じて最適なプリント方法をご提案します。',
    tags: ['DTFプリント', 'シルクスクリーン', 'UVプリント'],
    image: '/images/facility/dtf-printer.jpg',
    alt: 'ミマキ製DTFプリンター（TxF150-75）',
    width: 1109,
    height: 1477,
  },
]

const stats = [
  { number: '11', unit: '台', label: '刺繍機' },
  { number: '4', unit: '台', label: 'プリント機' },
  { number: '7', unit: '台', label: '熱プレス機' },
  { number: '2', unit: '台', label: 'レーザー加工機' },
]
import { url } from '../utils/paths'
---

<Layout
  title="タグチ刺繍ネーム有限会社｜茨城県筑西市の刺繍・プリント・ワッペン加工工場"
  description="茨城県筑西市の刺繍・プリント加工工場、タグチ刺繍ネーム有限会社。1960年創業。ユニフォーム・作業着・キャップへの刺繍やDTFプリント、ワッペン・ネーム製作を1枚から承ります。筑西市を拠点に茨城県全域・全国に対応。"
>

  <link
    slot="head"
    rel="preload"
    as="image"
    href={url("/images/facility/factory-work-02.webp")}
    type="image/webp"
    fetchpriority="high"
  />

  <!-- ============================================
       HERO
       ============================================ -->
  <section class="relative min-h-[520px] md:min-h-[620px] flex items-center">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <picture>
        <source type="image/webp" srcset={url("/images/facility/factory-work-02.webp")} />
        <img
          src={url("/images/facility/factory-work-02.jpg")}
          alt=""
          width="1660"
          height="1080"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-0 bg-navy-800/70"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 md:px-8 py-20 md:py-28">
      <div class="max-w-2xl lg:max-w-3xl mx-auto text-center">
        <h1 class="heading-accent text-[1.5rem] sm:text-4xl md:text-[3.25rem] lg:text-6xl text-white leading-snug md:leading-tight mb-5 md:mb-6">
          刺繍とプリント、<br /><span class="whitespace-nowrap">65年</span>の技術と誇り
        </h1>
        <div class="w-12 h-0.5 bg-gold-400 mb-5 md:mb-6 mx-auto"></div>
        <p class="text-base sm:text-lg md:text-xl text-white leading-relaxed mb-8 max-w-2xl mx-auto">
          <span class="inline-block">刺繍・ネーム・プリント加工のことなら、</span><span class="inline-block font-bold text-gold-300">タグチ刺繍ネームへ</span><br />
          <span class="inline-block text-navy-100">ユニフォームの名入れから、</span><span class="inline-block text-navy-100">企業ロゴのプリント、</span><span class="inline-block text-navy-100">ワッペンまで。</span><span class="inline-block text-navy-100">茨城県筑西市の自社工場で承ります。</span>
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={url("/contact")}
            class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md"
          >
            お問い合わせ
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="tel:0296-57-2644"
            class="inline-flex items-center gap-2 text-white hover:text-gold-300 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span class="text-lg font-medium tracking-wide">0296-57-2644</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       PHILOSOPHY (経営理念)
       ============================================ -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">
      <div class="js-fade-in text-center">
        <h2 class="heading-accent text-2xl md:text-[2rem] text-navy-800 leading-snug mb-10">
          <span class="gold-underline">経営理念</span>
        </h2>
        <Philosophy />
      </div>
    </div>
  </section>

  <!-- ============================================
       STRENGTHS (3つの強み)
       ============================================ -->
  <section class="py-section-sm md:py-section bg-warm-50">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading ja="タグチの強み" />

      <div class="js-fade-in bg-white rounded-lg border border-warm-200 border-t-4 border-t-gold-400 p-8 md:p-10 text-center mb-6 md:mb-8 hover:shadow-md transition-shadow duration-200">
        <h3 class="heading-accent text-xl md:text-2xl text-navy-800 leading-snug mb-4 ">{pillar.title.split('、').map((t, i, arr) => <span class="inline-block">{i < arr.length - 1 ? `${t}、` : t}</span>)}</h3>
        <p class="text-sm md:text-base text-warm-600 leading-relaxed max-w-2xl mx-auto">{pillar.description}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {supports.map((item, i) => (
          <div
            class="js-fade-in bg-white rounded-lg border border-warm-200 p-8 hover:shadow-md hover:-translate-y-0.5 hover:border-gold-300 transition-all duration-200"
            style={`transition-delay: ${i * 100}ms`}
          >
            <p class="text-lg font-bold text-navy-800 mb-3">{item.label}</p>
            <p class="text-sm text-warm-600 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       SERVICES (サービス概要)
       ============================================ -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading ja="加工サービス" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        {services.map((item, i) => (
          <a
            href={url(item.href)}
            class="js-fade-in group flex flex-col bg-white rounded-lg border border-warm-200 overflow-hidden hover:shadow-md hover:-translate-y-0.5 hover:border-gold-300 transition-all duration-200"
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="aspect-video overflow-hidden">
              <picture>
                <source type="image/webp" srcset={url(item.image.replace(/\.jpg$/, '.webp'))} />
                <img
                  src={url(item.image)}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="flex flex-col flex-1 p-6 md:p-8">
              <h3 class="text-xl md:text-2xl font-bold text-navy-800 mt-1 mb-3 group-hover:text-navy-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-warm-600 leading-relaxed">{item.description}</p>
              <div class="mt-5 pt-5 border-t border-warm-200">
                <p class="text-xs font-medium text-gold-700 mb-3">こんな加工ができます</p>
                <ul class="flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <li class="inline-block text-xs md:text-sm text-navy-800 bg-navy-50 border border-navy-100 px-3 py-1 rounded-full">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
              <span class="mt-auto pt-6 inline-flex items-center text-sm text-gold-600 font-medium group-hover:text-gold-500 transition-colors">
                {item.title}の詳細を見る
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       STATS (実績数字)
       ============================================ -->
  <section class="py-section-sm md:py-section bg-navy-50">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading ja="設備一覧" />

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10 md:mb-14">
        {stats.map((item, i) => (
          <div
            class="js-fade-in bg-white rounded-lg border border-warm-200 p-6 md:p-8 text-center"
            style={`transition-delay: ${i * 80}ms`}
          >
            <span class="heading-accent text-3xl md:text-5xl text-navy-800">{item.number}</span>
            <span class="text-gold-500 text-lg md:text-2xl ml-0.5 font-medium">{item.unit}</span>
            <p class="text-warm-600 text-xs md:text-sm mt-2">{item.label}</p>
          </div>
        ))}
      </div>

      <!-- Equipment Detail Table -->
      <div class="js-fade-in bg-white rounded-lg border border-warm-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-navy-800 text-white">
              <th class="px-4 md:px-6 py-3 text-left font-medium tracking-wide">分類</th>
              <th class="px-4 md:px-6 py-3 text-left font-medium tracking-wide">設備名</th>
              <th class="px-4 md:px-6 py-3 text-center font-medium tracking-wide">台数</th>
              <th class="px-4 md:px-6 py-3 text-left font-medium tracking-wide hidden md:table-cell">用途</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">刺繍機</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                多頭機（10頭・6頭・4頭）
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">量産対応</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">3台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">量産対応</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">刺繍機</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                単頭機
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">多品種小ロット対応</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">8台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">多品種小ロット対応</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">プリント</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                DTFプリンター
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">小ロット対応</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">1台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">小ロット対応</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">プリント</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                シルクスクリーン（自動機・手動機）
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">量産対応</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">2台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">量産対応</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">プリント</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                UVプリンター
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">アクリルスタンド・名札</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">1台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">アクリルスタンド・名札</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">縫製</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">本縫いミシン</td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">2台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell"></td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">縫製</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">特殊ミシン</td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">1台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell"></td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">仕上げ</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                熱プレス機
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">後工程</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">7台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">後工程</td>
            </tr>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-4 md:px-6 py-3 text-warm-700">仕上げ</td>
              <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                レーザー加工機
                <p class="text-xs text-warm-500 font-normal mt-0.5 md:hidden">後工程</p>
              </td>
              <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">2台</td>
              <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">後工程</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================
       EVENT (お知らせ・イベント)
       ============================================ -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading ja="イベント" />

      <a
        href={url("/events/hosei-visit")}
        class="js-fade-in group grid grid-cols-1 md:grid-cols-[400px_1fr] gap-6 bg-white rounded-lg border border-warm-200 overflow-hidden hover:shadow-md hover:border-gold-300 transition-all duration-200"
      >
        <div class="overflow-hidden">
          <picture>
            <source type="image/webp" srcset={url("/images/events/hosei-visit/hosei-08.webp")} />
            <img
              src={url("/images/events/hosei-visit/hosei-08.jpg")}
              alt="法政大学 岩瀬ゼミの皆さまの工場見学の様子"
              width="1200"
              height="900"
              class="w-full h-full object-cover aspect-video md:aspect-auto group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="p-6 md:py-8 flex flex-col justify-center">
          <span class="inline-block text-xs text-gold-600 font-medium bg-gold-50 px-3 py-1 rounded-full w-fit mb-3">
            イベントレポート
          </span>
          <h3 class="text-lg md:text-xl font-bold text-navy-800 mb-2 group-hover:text-navy-600 transition-colors">
            法政大学 岩瀬ゼミの皆さまが工場見学にお越しくださいました
          </h3>
          <p class="text-sm text-warm-600 leading-relaxed mb-4">
            法政大学 経営大学院 岩瀬ゼミの皆さまに、刺繍加工やプリント工程など自社工場の現場をご見学いただきました。
          </p>
          <span class="inline-flex items-center text-sm text-gold-600 font-medium group-hover:text-gold-500 transition-colors">
            レポートを見る
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
      </a>

      <div class="text-center mt-6">
        <a href={url("/events")} class="inline-flex items-center text-sm text-gold-600 font-medium hover:text-gold-500 transition-colors">
          イベント一覧を見る
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================
       CTA BAND (お問い合わせ導線)
       ============================================ -->
  <section class="py-section-sm md:py-section bg-navy-800">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8 text-center">
      <div class="js-fade-in">
        <h2 class="heading-accent text-2xl md:text-3xl text-white mb-4">
          まずはお気軽にご相談ください
        </h2>
        <p class="text-navy-200 text-sm md:text-base mb-8 max-w-lg mx-auto leading-relaxed">
          刺繍・プリント加工のお見積り、サンプルのご依頼、<br class="hidden md:block" />
          加工方法のご相談など、どんなことでもお問い合わせください。<br class="hidden md:block" />
          筑西市を拠点に、茨城県全域・関東一円、全国からのご依頼に対応しています。
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <a
            href={url("/contact")}
            class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md"
          >
            お問い合わせフォーム
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
