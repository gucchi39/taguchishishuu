---
import Layout from '../layouts/Layout.astro'
import BusinessCalendar from '../components/BusinessCalendar.astro'
import { url } from '../utils/paths'
---

<Layout
  title="営業カレンダー｜タグチ刺繍ネーム｜茨城県筑西市の刺繍・プリント加工"
  description="タグチ刺繍ネーム有限会社（茨城県筑西市）の営業日・休業日カレンダーです。営業時間は9:00〜17:45、日曜・祭日休み、土曜は不定期休み。刺繍・プリント加工のご注文や納期のご相談にお役立てください。"
>

  <section class="relative h-48 md:h-64 flex items-center">
    <div class="absolute inset-0 bg-navy-800"></div>
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 md:px-8 w-full">
      <p class="text-sm text-gold-300 tracking-[0.2em] uppercase mb-2">Calendar</p>
      <h1 class="heading-accent text-2xl md:text-4xl text-white">営業カレンダー</h1>
      <p class="text-navy-200 text-sm mt-2">営業日・休業日のご案内です</p>
    </div>
  </section>

  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">

      <div class="js-fade-in">
        <BusinessCalendar />
      </div>

      <!-- 営業時間 -->
      <div class="js-fade-in mt-10 rounded-lg border border-warm-200 bg-warm-50 p-5 md:p-6">
        <h2 class="heading-accent text-base md:text-lg text-navy-800 mb-3">営業時間</h2>
        <dl class="space-y-2 text-sm">
          <div class="flex gap-3">
            <dt class="text-warm-500 shrink-0 w-20">受付時間</dt>
            <dd class="text-warm-800">AM9:00〜17:45</dd>
          </div>
          <div class="flex gap-3">
            <dt class="text-warm-500 shrink-0 w-20">定休日</dt>
            <dd class="text-warm-800">日曜・祭日／土曜不定期休</dd>
          </div>
        </dl>
        <p class="text-xs text-warm-500 mt-4 leading-relaxed">
          休業日中にいただいたお問い合わせは、翌営業日以降に順次ご返信いたします。
        </p>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-section-sm md:py-section bg-navy-800">
    <div class="mx-auto max-w-[800px] px-4 md:px-8 text-center">
      <div class="js-fade-in">
        <h2 class="heading-accent text-xl md:text-2xl text-white mb-3">納期のご相談も承ります</h2>
        <p class="text-navy-200 text-sm mb-6">お急ぎの案件は特急対応も可能です。まずはお気軽にご相談ください。</p>
        <a href={url("/contact")} class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md">
          お問い合わせ
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
