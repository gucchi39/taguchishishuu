---
import Layout from '../layouts/Layout.astro'
import SectionHeading from '../components/SectionHeading.astro'

const highlights = [
  {
    title: '6頭式刺繍機',
    image: '/images/facility/factory-work-02.jpg',
    alt: '6頭式バルダン刺繍機',
    width: 1920,
    height: 1080,
    description: '6つの刺繍ヘッドで同じデザインを一度に6枚縫える多頭式刺繍機。量産のご注文も効率よく仕上げます。',
    points: ['同じデザインを一度に6枚', '量産・大口のご注文に対応', '多色の刺繍に対応'],
  },
  {
    title: 'DTFプリンター',
    image: '/images/facility/dtf-printer-body.jpg',
    alt: 'ミマキ製DTFプリンター（TxF150-75）',
    width: 1109,
    height: 977,
    description: 'フィルムに印刷した柄を生地に写す、新しい方式の転写プリンター（DTF）です。版が不要で、フルカラーのプリントができます。小ロットにも対応します。',
    points: ['版不要でフルカラー対応', '小ロットにも対応'],
  },
  {
    title: 'UVプリンター',
    image: '/images/facility/uv-printer.jpg',
    alt: 'ローランド製UVプリンター（VersaUV LEF-300）',
    width: 1600,
    height: 1200,
    description: 'UV硬化インクを使用するプリンターです。アクリルスタンドや名札の製作に使っています。',
    points: ['アクリルスタンド・名札の製作', '高精細なフルカラー表現'],
  },
  {
    title: 'レーザー加工機',
    image: '/images/facility/laser-cutter-body.jpg',
    alt: 'Universal製レーザー加工機',
    width: 1109,
    height: 770,
    description: 'Universal製のレーザー加工機を2台保有。ワッペンのヒートカット（切り抜き）と、名札の加工に使っています。名札は、二層になった板の上の層を削って、下の色を出します。',
    points: ['ワッペンのヒートカット（切り抜き）', '名札の加工（二層板の上の層を削って下の色を出す）', '2台保有'],
  },
]

// 先頭（刺繍機）は横長写真のため横長の大きなカードで、残りは3列で並べる
const [featured, ...otherHighlights] = highlights

const craftsmanship = [
  {
    title: '刺繍',
    image: '/images/facility/embroidery-line.jpg',
    alt: 'バルダン多頭式刺繍機が並ぶ刺繍ライン',
    width: 1109,
    height: 1477,
    description: '多頭機3台・単頭機8台、合計11台の刺繍機があります。同じ柄をまとまった枚数で縫うご注文は多頭機、1枚ごとに違う名前入れや少ない枚数のご注文は単頭機と、当社ではご注文に合わせて使い分けています。',
    points: ['多頭機3台で量産に対応', '単頭機8台で多品種・小ロットに対応'],
  },
  {
    title: 'プリント',
    image: '/images/facility/dtf-printer-body.jpg',
    alt: 'ミマキ製DTFプリンター（TxF150-75）',
    width: 1109,
    height: 977,
    description: 'DTF・シルクスクリーン・UVの3つのプリント方法があります。枚数や品物をうかがって、合う方法をお伝えします。刺繍もプリントも、一社でまとめてお任せいただけます。',
    points: ['DTF：フルカラー・小ロットにも対応', 'シルクスクリーン：量産向き（自動機・手動機の2台）', 'UV：アクリルスタンド・名札'],
  },
]

const equipment = [
  { category: '刺繍機', name: '多頭機', count: '3台', use: '量産対応' },
  { category: '刺繍機', name: '単頭機', count: '8台', use: '多品種小ロット対応' },
  { category: 'プリント', name: 'DTFプリンター', count: '1台', use: 'フルカラー・小ロットにも対応' },
  { category: 'プリント', name: 'シルクスクリーン（自動機・手動機）', count: '2台', use: '量産対応' },
  { category: 'プリント', name: 'UVプリンター', count: '1台', use: 'アクリルスタンド・名札' },
  { category: '縫製', name: '本縫いミシン', count: '2台', use: '' },
  { category: '縫製', name: '特殊ミシン', count: '1台', use: '' },
  { category: '仕上げ', name: '熱プレス機', count: '7台', use: '転写・仕上げ' },
  { category: '仕上げ', name: 'レーザー加工機（Universal）', count: '2台', use: 'ワッペンのヒートカット・名札の加工' },
]

const photos = [
  { src: '/images/facility/embroidery-line.jpg', caption: '多頭式刺繍ライン', width: 1109, height: 1477 },
  { src: '/images/facility/happy-japan.jpg', caption: '単頭刺繍機', width: 1109, height: 1477 },
  { src: '/images/facility/heat-press-cap.jpg', caption: 'キャップ用ヒートプレス', width: 1109, height: 1477 },
  { src: '/images/facility/heat-press-large.jpg', caption: '平台ヒートプレス', width: 1109, height: 1477 },
  { src: '/images/facility/laser-cutter-body.jpg', caption: 'Universal レーザーカッター', width: 1109, height: 770 },
  { src: '/images/facility/dryer.jpg', caption: 'コンベア式乾燥機', width: 1109, height: 1477 },
  { src: '/images/facility/uv-printer.jpg', caption: 'UVプリンター', width: 1600, height: 1200 },
  { src: '/images/facility/factory-work-02.jpg', caption: '多頭式刺繍機の稼働', width: 1920, height: 1080 },
]

const stats = [
  { number: '11', unit: '台', label: '刺繍機' },
  { number: '4', unit: '台', label: 'プリント機' },
  { number: '7', unit: '台', label: '熱プレス機' },
  { number: '2', unit: '台', label: 'レーザー加工機' },
]

import { url } from '../utils/paths'
---

<Layout
  title="刺繍機・プリンター設備紹介｜タグチ刺繍ネーム｜茨城県筑西市の刺繍・プリント加工"
  description="多頭機3台・単頭機8台の刺繍機、DTF・シルクスクリーン・UVプリンター、レーザー加工機など、茨城県筑西市の自社工場の設備をご紹介。小ロットから量産まで対応します。"
>

  <section class="relative h-48 md:h-64 flex items-center">
    <div class="absolute inset-0">
      <picture>
        <source type="image/webp" srcset={url("/images/facility/embroidery-line.webp")} />
        <img src={url("/images/facility/embroidery-line.jpg")} alt="" width="1109" height="1477" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="absolute inset-0 bg-navy-800/70"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 md:px-8 w-full">
      <p class="text-sm text-gold-300 tracking-[0.2em] uppercase mb-2">Facility & Technology</p>
      <h1 class="heading-accent text-2xl md:text-4xl text-white">刺繍機・プリンターなどの<br class="sm:hidden" />設備紹介</h1>
      <p class="text-navy-200 text-sm mt-2">筑西市の自社工場にある、刺繍・プリントの設備をご紹介します</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Equipment" ja="数字で見る設備力" />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {stats.map((item, i) => (
          <div class="js-fade-in bg-white rounded-lg border border-warm-200 p-6 md:p-8 text-center" style={`transition-delay: ${i * 80}ms`}>
            <span class="heading-accent text-3xl md:text-5xl text-navy-800">{item.number}</span>
            <span class="text-gold-500 text-lg md:text-2xl ml-0.5 font-medium">{item.unit}</span>
            <p class="text-warm-600 text-xs md:text-sm mt-2">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 主な設備 -->
  <section id="latest" class="py-section-sm md:py-section bg-gold-50">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Main Equipment" ja="主な設備" />
      <p class="text-center text-warm-600 text-sm -mt-8 mb-10">
        多頭式刺繍機による量産から、フルカラープリント、アクリルスタンドや名札の印刷、レーザー加工まで。自社工場の主な設備をご紹介します
      </p>

      <!-- 刺繍の設備（横長の大きなカード） -->
      <div class="js-fade-in grid grid-cols-1 lg:grid-cols-2 bg-white rounded-lg border border-warm-200 overflow-hidden mb-6 lg:mb-8">
        <picture class="block">
          <source type="image/webp" srcset={url(featured.image.replace(/\.jpg$/, '.webp'))} />
          <img src={url(featured.image)} alt={featured.alt} width={featured.width} height={featured.height} class="w-full h-full aspect-[4/3] lg:aspect-auto lg:min-h-[320px] object-cover" loading="lazy" decoding="async" />
        </picture>
        <div class="flex flex-col justify-center p-5 md:p-8 lg:p-10">
          <div class="flex items-center gap-3 mb-3">
            <h3 class="text-lg md:text-xl font-bold text-navy-800">{featured.title}</h3>
          </div>
          <p class="text-sm text-warm-700 leading-relaxed mb-5">{featured.description}</p>
          <ul class="space-y-2 pt-4 border-t border-warm-200">
            {featured.points.map((p) => (
              <li class="flex items-start gap-2 text-sm text-warm-700">
                <svg class="w-4 h-4 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- プリント・レーザーの設備（3列。カードの高さを揃え、points を下端に寄せる） -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        {otherHighlights.map((item, i) => (
          <div class="js-fade-in flex flex-col bg-white rounded-lg border border-warm-200 overflow-hidden" style={`transition-delay: ${i * 100}ms`}>
            <picture class="block">
              <source type="image/webp" srcset={url(item.image.replace(/\.jpg$/, '.webp'))} />
              <img src={url(item.image)} alt={item.alt} width={item.width} height={item.height} class="w-full aspect-[4/3] object-cover" loading="lazy" decoding="async" />
            </picture>
            <div class="flex flex-col flex-1 p-5 md:p-6">
              <div class="flex items-center gap-3 mb-3">
                <h3 class="text-lg md:text-xl font-bold text-navy-800">{item.title}</h3>
              </div>
              <p class="text-sm text-warm-700 leading-relaxed mb-5">{item.description}</p>
              <ul class="mt-auto space-y-2 pt-4 border-t border-warm-200">
                {item.points.map((p) => (
                  <li class="flex items-start gap-2 text-sm text-warm-700">
                    <svg class="w-4 h-4 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 設備を活かす技術 -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Technology" ja="設備を活かす技術" />

      {craftsmanship.map((item, i) => (
        <div class={`js-fade-in grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center ${i > 0 ? 'mt-12 md:mt-16' : ''}`} style={`transition-delay: ${i * 100}ms`}>
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            <picture>
              <source type="image/webp" srcset={url(item.image.replace(/\.jpg$/, '.webp'))} />
              <img src={url(item.image)} alt={item.alt} width={item.width} height={item.height} class="w-full aspect-video object-cover rounded-lg" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
            <h3 class="heading-accent text-lg md:text-xl text-navy-800 mb-4">
              <span class="gold-underline">{item.title}</span>
            </h3>
            <p class="text-sm text-warm-700 leading-relaxed mb-5">{item.description}</p>
            <ul class="space-y-2">
              {item.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-warm-700">
                  <svg class="w-5 h-5 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Equipment Table -->
  <section class="py-section-sm md:py-section bg-warm-50">
    <div class="mx-auto max-w-[1000px] px-4 md:px-8">
      <SectionHeading en="Equipment List" ja="設備一覧" />
      <div class="js-fade-in bg-white rounded-lg border border-warm-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-navy-800 text-white">
              <th class="px-4 md:px-6 py-3 text-left font-medium">分類</th>
              <th class="px-4 md:px-6 py-3 text-left font-medium">設備名</th>
              <th class="px-4 md:px-6 py-3 text-center font-medium">台数</th>
              <th class="px-4 md:px-6 py-3 text-left font-medium hidden md:table-cell">用途</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            {equipment.map((row) => (
              <tr class="hover:bg-warm-50 transition-colors">
                <td class="px-4 md:px-6 py-3 text-warm-700">{row.category}</td>
                <td class="px-4 md:px-6 py-3 font-medium text-navy-800">
                  {row.name}
                </td>
                <td class="px-4 md:px-6 py-3 text-center font-bold text-navy-800">{row.count}</td>
                <td class="px-4 md:px-6 py-3 text-warm-600 hidden md:table-cell">{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <section id="gallery" class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Gallery" ja="設備フォトギャラリー" />
      <p class="text-center text-warm-600 text-sm -mt-8 mb-10 leading-relaxed">
        掲載している写真は一部です。<br class="sm:hidden" />このほかにも、加工内容に合わせたさまざまな設備を備えています。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {photos.map((photo, i) => (
          <figure class="js-fade-in bg-white rounded-lg border border-warm-200 overflow-hidden" style={`transition-delay: ${i * 60}ms`}>
            <picture>
              <source type="image/webp" srcset={url(photo.src.replace(/\.jpg$/, '.webp'))} />
              <img src={url(photo.src)} alt={photo.caption} width={photo.width} height={photo.height} class="w-full aspect-[4/3] object-cover" loading="lazy" decoding="async" />
            </picture>
            <figcaption class="px-3 py-2 text-xs text-warm-600">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section-sm md:py-section bg-navy-800">
    <div class="mx-auto max-w-[800px] px-4 md:px-8 text-center">
      <div class="js-fade-in">
        <h2 class="heading-accent text-xl md:text-2xl text-white mb-3">設備・加工に関するご相談</h2>
        <p class="text-navy-200 text-sm mb-6">「こんな加工はできる？」など、お気軽にお問い合わせください。工場見学も歓迎です。</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={url("/contact")} class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md">
            お問い合わせ
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
