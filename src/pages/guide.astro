---
import Layout from '../layouts/Layout.astro'
import SectionHeading from '../components/SectionHeading.astro'

// データ入稿ガイド（/service と重複しない、このページ独自の内容）
const dataGuide = [
  {
    title: '推奨ファイル形式',
    description: 'AI（Illustrator）・PDF が最適です。PNG・JPEG でも承ります。スマホで撮影した画像でもまずはご相談ください。',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  },
  {
    title: '解像度の目安',
    description: 'PNG・JPEG の場合は、できるだけ高解像度の画像をお送りください（仕上がりサイズで 300dpi 程度、または長辺 1000px 以上が目安です）。小さな画像は線がぼやけ、再現性が下がります。',
    icon: 'M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15',
  },
  {
    title: '文字はアウトライン化を',
    description: 'AI・PDF で文字を含む場合は、アウトライン化（図形化）してからお送りください。難しい場合は、使用しているフォント名を明記していただければ対応いたします。',
    icon: 'M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z',
  },
  {
    title: '色の指定',
    description: 'ご希望の色は、DIC・PANTONE などの色番号や「コーポレートカラーと同じ色」など、分かる範囲でお知らせください。刺繍は糸の色見本から近い色をご提案します。',
    icon: 'M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z',
  },
  {
    title: '手描き・写真からもOK',
    description: 'データがなくても大丈夫です。手描きのラフスケッチや写真、お手元の刺繍品からデータを起こすこともできます。お気軽にご相談ください。',
    icon: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10',
  },
  {
    title: 'データの送り方',
    description: 'お問い合わせフォームからご連絡いただくとメールアプリが開きますので、そのメールにデータを添付してお送りください。データが大きい場合や送り方に迷う場合は、お電話（0296-57-2644）でご案内します。',
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
  },
]
import { url } from '../utils/paths'
---

<Layout
  title="刺繍加工ガイド｜タグチ刺繍ネーム｜茨城県筑西市の刺繍・プリント加工"
  description="初めての方向けの刺繍加工ガイド。刺繍の特長と、ロゴ・文字データの入稿方法（ファイル形式・解像度・アウトライン化・色指定）をわかりやすく解説します。茨城県筑西市でユニフォーム・作業着の名入れを手がけるタグチ刺繍ネームがご案内します。"
>

  <section class="relative h-48 md:h-64 flex items-center">
    <div class="absolute inset-0 bg-navy-800"></div>
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 md:px-8 w-full">
      <p class="text-sm text-gold-300 tracking-[0.2em] uppercase mb-2">Guide</p>
      <h1 class="heading-accent text-2xl md:text-4xl text-white">刺繍加工ガイド</h1>
      <p class="text-navy-200 text-sm mt-2">初めてのお客様へ。刺繍加工の基本をわかりやすくご案内します。</p>
    </div>
  </section>

  <!-- What is embroidery -->
  <section class="py-section-sm md:py-section">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">
      <SectionHeading en="What is Embroidery?" ja="刺繍加工とは" />
      <div class="js-fade-in text-warm-800 leading-relaxed space-y-4">
        <p>
          刺繍加工とは、専用のミシン（刺繍機）を使って、布地に糸で模様や文字を縫い込む加工技術です。
          プリントとは異なり、糸そのものが素材に定着するため、立体感・高級感があり、洗濯を繰り返しても色落ちしにくいのが最大の特長です。
        </p>
        <p>
          当社では、コンピュータ制御の多頭式・単頭式刺繍機を合計14台保有しており、1枚からの少量注文から大量生産まで柔軟に対応しています。
        </p>
      </div>
    </div>
  </section>

  <!-- Link to service (比較表・用途は加工サービスページに集約) -->
  <section class="pb-section-sm md:pb-section">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">
      <a href={url("/service")} class="js-fade-in group flex flex-col sm:flex-row sm:items-center gap-4 bg-white rounded-lg border border-warm-200 p-6 hover:shadow-md hover:border-gold-300 transition-all duration-200">
        <div class="flex-1">
          <p class="text-xs text-gold-600 tracking-[0.2em] uppercase mb-1">Service</p>
          <h3 class="font-bold text-navy-800 mb-1">刺繍とプリントの比較・用途例</h3>
          <p class="text-sm text-warm-700 leading-relaxed">刺繍とプリントの違い（質感・耐久性・色数・ロット）や、ユニフォーム・記念品などの用途例は加工サービスページでご案内しています。</p>
        </div>
        <span class="shrink-0 inline-flex items-center text-sm font-medium text-navy-800 group-hover:text-gold-700 transition-colors">加工サービスを見る<svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></span>
      </a>
    </div>
  </section>

  <!-- Data guide -->
  <section class="py-section-sm md:py-section bg-warm-50">
    <div class="mx-auto max-w-[1200px] px-4 md:px-8">
      <SectionHeading en="Data Guide" ja="データ入稿ガイド" />
      <p class="text-center text-warm-600 text-sm -mt-8 mb-10">
        ロゴや文字のデータをお送りいただく際のポイントです。分からない点はお気軽にお尋ねください。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {dataGuide.map((item, i) => (
          <div class="js-fade-in bg-white rounded-lg border border-warm-200 p-6 hover:shadow-md hover:border-gold-300 transition-all duration-200" style={`transition-delay: ${i * 60}ms`}>
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gold-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              <h3 class="text-base font-bold text-navy-800">{item.title}</h3>
            </div>
            <p class="text-sm text-warm-600 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For individuals -->
  <section class="py-section-sm md:py-section bg-navy-50">
    <div class="mx-auto max-w-[800px] px-4 md:px-8">
      <SectionHeading en="For Individuals" ja="個人のお客様へ" />
      <div class="js-fade-in bg-white rounded-lg border border-warm-200 p-6">
        <p class="text-sm text-warm-700 leading-relaxed">
          「1枚だけでも注文できますか？」──はい、もちろん承ります。お子様のお名前入れ、チームのユニフォーム、記念品など、個人のお客様も大歓迎です。
        </p>
      </div>
    </div>
  </section>

  <section class="py-section-sm md:py-section bg-navy-800">
    <div class="mx-auto max-w-[800px] px-4 md:px-8 text-center">
      <div class="js-fade-in">
        <h2 class="heading-accent text-xl md:text-2xl text-white mb-3">お気軽にご相談ください</h2>
        <p class="text-navy-200 text-sm mb-6">「こんなことできる？」というご質問だけでも大丈夫です。</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={url("/contact")} class="inline-flex items-center px-8 py-3.5 bg-gold-500 text-navy-950 font-medium rounded tracking-wider hover:bg-gold-400 transition-all duration-200 hover:-translate-y-px hover:shadow-md">
            お問い合わせ
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href={url("/faq")} class="inline-flex items-center px-8 py-3.5 border border-navy-400 text-white rounded tracking-wider hover:bg-navy-700 transition-all duration-200">よくある質問</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
