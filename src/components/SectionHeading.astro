---
// 英語の小見出し（以前の en）は、社長の方針（英語の見出しを説明なしに置かない）に合わせて廃止した
interface Props {
  ja: string
  align?: 'left' | 'center'
}

const { ja, align = 'center' } = Astro.props
const alignClass = align === 'center' ? 'text-center' : 'text-left'
---

<div class={`${alignClass} mb-10 md:mb-14`}>
  <h2 class="heading-accent text-2xl md:text-[2rem] text-navy-800 leading-snug [text-wrap:balance]">
    <span class="gold-underline">{ja}</span>
  </h2>
</div>
