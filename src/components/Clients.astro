---
/**
 * 主な取引先・実績
 * 内容は src/data/trust.ts の clients で管理。空の場合は「準備中」を表示する。
 */
import SectionHeading from './SectionHeading.astro'
import { clients, pendingMessage } from '../data/trust'

interface Props {
  /** セクションに追加するクラス（背景色の交互パターン用。例: 'bg-warm-50'） */
  class?: string
}
const { class: className = '' } = Astro.props
---

<section class:list={['py-section-sm md:py-section', className]}>
  <div class="mx-auto max-w-[1000px] px-4 md:px-8">
    <SectionHeading en="Clients" ja="主な取引先・実績" />

    {clients.length === 0 ? (
      <div class="js-fade-in max-w-[800px] mx-auto px-6 py-8 rounded-lg bg-gold-50 border border-gold-200 text-center">
        <p class="text-sm text-gold-800 leading-relaxed">{pendingMessage}</p>
      </div>
    ) : (
      <ul class="js-fade-in flex flex-wrap justify-center gap-3">
        {clients.map((item) => (
          <li class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 max-w-full px-5 py-2.5 rounded-full bg-white border border-warm-200 text-center">
            <span class="text-sm font-medium text-navy-800">{item.name}</span>
            {item.note && (
              <span class="text-xs text-gold-700">{item.note}</span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
