---
/**
 * 働く人の声
 * 内容は src/data/trust.ts の staffVoices で管理。空の場合は「準備中」を表示する。
 */
import SectionHeading from './SectionHeading.astro'
import { staffVoices, pendingMessage } from '../data/trust'

interface Props {
  /** セクションに追加するクラス（背景色の交互パターン用。例: 'bg-warm-50'） */
  class?: string
}
const { class: className = '' } = Astro.props
---

<section class:list={['py-section-sm md:py-section', className]}>
  <div class="mx-auto max-w-[1000px] px-4 md:px-8">
    <SectionHeading en="Staff Voice" ja="働く人の声" />

    {staffVoices.length === 0 ? (
      <div class="js-fade-in max-w-[800px] mx-auto px-6 py-8 rounded-lg bg-gold-50 border border-gold-200 text-center">
        <p class="text-sm text-gold-800 leading-relaxed">{pendingMessage}</p>
      </div>
    ) : (
      <!-- 件数が奇数でも中央にそろうよう flex で2列に並べる -->
      <div class="flex flex-wrap justify-center gap-6">
        {staffVoices.map((item, i) => (
          <article
            class="js-fade-in w-full md:w-[calc((100%-1.5rem)/2)] bg-white rounded-lg border border-warm-200 p-6 md:p-8"
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-navy-50 text-navy-600 shrink-0" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
              </div>
              <div>
                <p class="text-base font-bold text-navy-800">{item.role}</p>
                <p class="text-xs text-gold-700 mt-0.5">{item.years}</p>
              </div>
            </div>
            <p class="text-sm text-warm-800 leading-relaxed">{item.body}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
